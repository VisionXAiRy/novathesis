%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% ips/univ-defaults.ldf
%% NOVA thesis configuration file
%%
%% Customization for INSTITUTO POLITÉCNICO DE SETÚBAL (strings and cover)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE ips/univ-defaults.ldf}%


% University
\university(pt):={Instituto Politécnico de Setúbal}
\university(en):={Polytechnic Institute of Setúbal}
\university(fr):={Polytechnic Institute of Setúbal}
\university(it):={Polytechnic Institute of Setúbal}

% Department
\department(pt):={Área Departamental de \themajorfield(pt)}
\department(en):={Department of \themajorfield(en)}

% Committee printing order
\committeeorder():={c,r,a,m}%

% Spine info
\spine(logo)={ips-logo}

% -----------------------------------------------------------------
% ATIVAÇÃO DA SEGUNDA CAPA (FOLHA DE ROSTO)
% -----------------------------------------------------------------
\ntsetup{print/secondcover=true}

% Set margins for "normal" pages
\margin(screen,top):={3.5cm}
\margin(screen,bottom):={2.5cm}
\margin(screen,left):={3.0cm}
\margin(screen,right):={3.0cm}
\margin(paper,top):={3.5cm}
\margin(paper,bottom):={2.5cm}
\margin(paper,left):={3.0cm}
\margin(paper,right):={3.0cm}

% Set margins for cover pages
\margin(cover,top):={2.0cm}
\margin(cover,bottom):={1.5cm}
\margin(cover,left):={3.0cm}
\margin(cover,right):={2.0cm}

% --- DEFINIÇÃO DE ETIQUETAS (MAIÚSCULAS) ---
% Definição robusta para PT e EN
\adviserstring(a,1,m,pt):={ORIENTADOR}
\adviserstring(a,1,f,pt):={ORIENTADOR}
\adviserstring(a,2,m,pt):={ORIENTADOR}
\adviserstring(a,2,f,pt):={ORIENTADOR}
\adviserstring(c,1,m,pt):={CO-ORIENTADOR}
\adviserstring(c,1,f,pt):={CO-ORIENTADOR}
\adviserstring(c,2,m,pt):={CO-ORIENTADOR}
\adviserstring(c,2,f,pt):={CO-ORIENTADOR}

\adviserstring(a,1,m,en):={SUPERVISOR}
\adviserstring(a,1,f,en):={SUPERVISOR}
\adviserstring(a,2,m,en):={SUPERVISOR}
\adviserstring(a,2,f,en):={SUPERVISOR}
\adviserstring(c,1,m,en):={CO-SUPERVISOR}
\adviserstring(c,1,f,en):={CO-SUPERVISOR}
\adviserstring(c,2,m,en):={CO-SUPERVISOR}
\adviserstring(c,2,f,en):={CO-SUPERVISOR}


\copyrighttextstring(pt)={A \theschool(\@LANG@COVER)\ e o \theuniversity(\@LANG@COVER)\ têm o direito, perpétuo e sem limites geográficos, de arquivar e publicar esta dissertação através de exemplares impressos reproduzidos em papel ou de forma digital, ou por qualquer outro meio conhecido ou que venha a ser inventado, e de a divulgar através de repositórios científicos e de admitir a sua cópia e distribuição com objetivos educacionais ou de investigação, não comerciais, desde que seja dado crédito ao autor e editor.}

\copyrighttextstring(en)={The \theschool(\@LANG@COVER)\ and the \theuniversity(\@LANG@COVER)\ have the right, perpetual and without geographical boundaries, to file and publish this dissertation through printed copies reproduced on paper or on digital form, or by any other means known or that may be invented, and to disseminate through scientific repositories and admit its copying and distribution for non-commercial, educational or research purposes, as long as credit is given to the author and editor.}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Draw the cover page
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\@leftcol}{0.37\linewidth}
\newcommand{\@rightcol}{0.55\linewidth}

\AtEndPreamble{%
  \LoadHelveticaLikeFont%
}

\NTAddToHook{cover/1-1/text/pre}{%
  \sffamily%
}
\NTAddToHook{cover/2-1/text/pre}{%
  \sffamily%
}

% LOGO
% Capa 1: Imprime o logótipo
\ntaddtocover[vspace=0cm]{1-1}{%
  \includegraphics[height=4.6cm]{\expanded{\theschool(logo)}}%
}
% Capa 2: Imprime espaço invisível da mesma altura para manter alinhamento
\ntaddtocover[vspace=0cm]{2-1}{%
  \rule{0cm}{4.6cm}%
}

% Author name and Title (AMBAS AS CAPAS)
\ntaddtocover[halign=l, vspace=5cm]{1-1,2-1}{%
  % Author name
  \begin{minipage}[t]{\@leftcol}%
    \fontsize{16}{16}\selectfont\raggedleft%
    \MakeUppercase{\thedocauthor(name)}%
  \end{minipage}%
  \hfill%
  % Title of Dissertation
  \begin{minipage}[t]{\@rightcol}%
    \fontsize{16}{16}\selectfont\raggedright%
    \textbf{\MakeUppercase{\thedoctitle(\@LANG@COVER,main,cover)}}%
  \end{minipage}%
}

% Photo with Warning Text (CAPA 1)
\ntaddtocover[halign=l, vspace=1]{1-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    \includegraphics[height=5.3cm]{\thefrontpageimage()}%
    \\[0.2cm]
    \fontsize{9}{10}\selectfont
    ATENÇÃO que o autor deverá ser proprietário da imagem (a imagem é sua ou adquiriu os direitos de autor), de forma a não comprometer a instituição em situações de uso da mesma.
  \end{minipage}%
}

% Espaço reservado da foto (CAPA 2)
% Mantém o espaçamento exato sem imagem nem texto de aviso
\ntaddtocover[halign=l, vspace=1]{2-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    % Régua invisível com a altura da imagem (5.3cm) + espaço do texto (aprox 1cm de margem de segurança)
    \rule{0cm}{5.3cm}%
  \end{minipage}%
}

% Degree (AMBAS AS CAPAS)
\ntaddtocover[halign=l, vspace=1]{1-1,2-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    \fontsize{12}{14}\selectfont\raggedright%
    \thepresentationtext%
  \end{minipage}%
}

% Advisers (AMBAS AS CAPAS)
\ntaddtocover[vspace=1]{1-1,2-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    \adviserstringfont(a):={\bfseries}%
    \adviserstringfont(c):={\bfseries}%
    \fontsize{12}{14}\selectfont%
    \ntprintpersons{1}{2}{adviser}{a,c}%
  \end{minipage}%
}

% Date (AMBAS AS CAPAS)
\ntaddtocover[vspace=2]{1-1,2-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    \fontsize{10}{10}\selectfont%
    \thentdocdate(submission,monthname) de \thentdocdate(submission,year)%
  \end{minipage}%
}

% NOTA: O bloco de "committee" (Júri) foi removido para garantir que
% a segunda capa seja visualmente idêntica à primeira (apenas texto),
% conforme solicitado. Se precisares do Júri, avisa.