%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% ips/ests/defaults.ldf
%% NOVA thesis configuration file
%%
%% Customization for ESTS-IPS (Escola Superior de Tecnologia de Setúbal)
%% Defines school-specific names, logos, and spine settings.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE ips/ests/defaults.ldf}%

% -----------------------------------------------------------------
% 1. SCHOOL IDENTITY
% -----------------------------------------------------------------

% Faculty / School Name
% Note: The English version is set to match the Portuguese one to force
% the official name in PT even if the document is compiled in 'en' mode.
\school(pt):={Escola Superior de Tecnologia de Setúbal}
\school(en):={Escola Superior de Tecnologia de Setúbal}

% If you want the translated name in the future, uncomment the line below:
%\school(en):={Setúbal School of Technology}


% -----------------------------------------------------------------
% 2. VISUAL ASSETS
% -----------------------------------------------------------------

% School Logo
% The file name of the logo that appears at the top of the cover.
\school(logo):={ips-ests-logo}

% Default Cover Image
% The default photograph used on the cover (can be overridden in template.tex).
% Note: Do not include the file extension (.jpg, .png).
\frontpageimage():={ips-ests-photo}


% -----------------------------------------------------------------
% 3. SPINE CONFIGURATION (For printed versions)
% -----------------------------------------------------------------

% Configures the text and logo on the side of the book (spine).
\SpineSetup[%
]{%
  box/logo/bg/image           = {ips-ests-icon}, % Small icon file for the spine
  box/logo/bg/image/angle     = {-90},           % Rotation angle for the logo
  box/title/len               = {18.6cm},        % Maximum length for the title text on the spine
  box/logo/len                = {2.1cm},         % Space reserved for the logo on the spine
}