%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% ips/univ-defaults.ldf
%% NOVA thesis configuration file
%%
%% Customization for INSTITUTO POLITÉCNICO DE SETÚBAL (IPS)
%% Visual adaptation to comply with specific design rules (fonts and covers).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\typeout{NT FILE ips/univ-defaults.ldf}%

% -----------------------------------------------------------------
% 1. GENERAL CONFIGURATION AND IDENTIFICATION
% -----------------------------------------------------------------

% University Name
% Note: The English version is set to match the Portuguese one to force
% the official name in PT even if the document is compiled in 'en' mode.
\university(pt):={Instituto Politécnico de Setúbal}
\university(en):={Instituto Politécnico de Setúbal}
% Original English option (commented out):
% \university(en):={Polytechnic Institute of Setúbal}

% Department (Automatic based on the major field defined in main.tex)
\department(pt):={Área Departamental de \themajorfield(pt)}
\department(en):={Department of \themajorfield(en)}

% Committee Printing Order (Page 2)
% Legend: c=Chair, r=Examiners/Rapporteurs, a=Supervisors, ca=Co-supervisors, m=Members
% IMPORTANT: 'a' and 'ca' must be here for supervisors to appear in the Jury list.
\committeeorder():={c,r,a,ca,m}%

% Cover Configuration
\spine(logo)={ips-logo}          % Spine logo (if applicable)
\ntsetup{print/secondcover=true} % Enables printing of the Second Cover (Front Page / Page 2)

% -----------------------------------------------------------------
% 2. MARGINS
% -----------------------------------------------------------------
% Margins for screen viewing and paper printing (inner pages)
\margin(screen,top):={3.5cm}
\margin(screen,bottom):={2.5cm}
\margin(screen,left):={3.0cm}
\margin(screen,right):={3.0cm}

\margin(paper,top):={3.5cm}
\margin(paper,bottom):={2.5cm}
\margin(paper,left):={3.0cm}
\margin(paper,right):={3.0cm}

% Specific margins exclusive to Covers (Page 1 and 2)
% Adjust here if the cover text is too close to the logo or footer.
\margin(cover,top):={2.0cm}
\margin(cover,bottom):={1.5cm}
\margin(cover,left):={3.0cm}
\margin(cover,right):={2.0cm}

% -----------------------------------------------------------------
% 3. STRINGS AND TRANSLATIONS (Only used in the covers)
% -----------------------------------------------------------------

% --- PRESENTATION TEXT (MSc Only) ---
% Defines the phrase "Relatório de Dissertação..." appearing in the middle of the cover.
\dissertationstring(msc,pt)={Relatório de Dissertação do Mestrado em \themajorfield(pt)}
\dissertationstring(mscplan,pt)={Relatório de Plano de Dissertação do Mestrado em \themajorfield(pt)}

% TRICK: Force PT text even in English (EN) mode
\dissertationstring(msc,en)={Relatório de Dissertação do Mestrado em \themajorfield(en)}
% Original English option (commented out):
% \dissertationstring(msc,en)={Dissertation/project/internship/research project report of the Master in \themajorfield(en)}

\dissertationstring(mscplan,en)={Relatório de Plano de Dissertação do Mestrado em \themajorfield(pt)}
% Original English option (commented out):
% \dissertationstring(mscplan,en)={Master Dissertation Plan / Intermediate Report of the Master in \themajorfield(en)}


% --- Committee Title (Page 2) ---
\committeetitlestring(pt):={JÚRI}

% Force PT text in EN mode
\committeetitlestring(en):={JÚRI}
% Original English option (commented out):
% \committeetitlestring(en):={JURY}

% --- Labels for COVER 1 (Supervisors - Bottom Block) ---
% Defines the text "ORIENTADOR" in uppercase as per design.
% a = Adviser (Principal), c = Co-adviser
\adviserstring(a,1,m,pt)  := {ORIENTADOR}
\adviserstring(a,1,f,pt)  := {ORIENTADORA}
\adviserstring(a,2,m,pt)  := {ORIENTADORES}
\adviserstring(a,2,f,pt)  := {ORIENTADORAS}
\adviserstring(c,1,m,pt)  := {CO-ORIENTADOR}
\adviserstring(c,1,f,pt)  := {CO-ORIENTADORA}
\adviserstring(c,2,m,pt)  := {CO-ORIENTADORES}
\adviserstring(c,2,f,pt)  := {CO-ORIENTADORAS}

% Force PT text in EN mode (Cover 1)
\adviserstring(a,1,m,en)  := {ORIENTADOR}
\adviserstring(a,1,f,en)  := {ORIENTADORA}
\adviserstring(a,2,m,en)  := {ORIENTADORES}
\adviserstring(a,2,f,en)  := {ORIENTADORAS}
\adviserstring(c,1,m,en)  := {CO-ORIENTADOR}
\adviserstring(c,1,f,en)  := {CO-ORIENTADORA}
\adviserstring(c,2,m,en)  := {CO-ORIENTADORES}
\adviserstring(c,2,f,en)  := {CO-ORIENTADORAS}

% Original English options (commented out):
% \adviserstring(a,1,m,en)  := {SUPERVISOR}
% \adviserstring(a,1,f,en)  := {SUPERVISOR}
% \adviserstring(a,2,m,en)  := {SUPERVISORS}
% \adviserstring(a,2,f,en)  := {SUPERVISORS}
% \adviserstring(c,1,m,en)  := {CO-SUPERVISOR}
% \adviserstring(c,1,f,en)  := {CO-SUPERVISOR}
% \adviserstring(c,2,m,en)  := {CO-SUPERVISORS}
% \adviserstring(c,2,f,en)  := {CO-SUPERVISORS}

% --- Labels for JURY / COVER 2 (Member List) ---
% Defines the prefix for each person in the front page list.
% Ex: "Presidente", "Vogal", "Orientador".
% Note: Colons (:) have been removed as requested.

% Portuguese
\committeestring(c,1,m,pt) := {Presidente}
\committeestring(c,1,f,pt) := {Presidente}
\committeestring(r,1,m,pt) := {Arguente}
\committeestring(r,1,f,pt) := {Arguente}
\committeestring(a,1,m,pt) := {Orientador}
\committeestring(a,1,f,pt) := {Orientadora}
\committeestring(ca,1,m,pt):= {Co-orientador}
\committeestring(ca,1,f,pt):= {Co-orientadora}
\committeestring(m,1,m,pt) := {Vogal}
\committeestring(m,1,f,pt) := {Vogal}
% Plurals
\committeestring(r,2,m,pt) := {Arguentes}
\committeestring(a,2,m,pt) := {Orientadores}
\committeestring(m,2,m,pt) := {Vogais}

% Force PT text in EN mode (Cover 2)
\committeestring(c,1,m,en) := {Presidente}
\committeestring(c,1,f,en) := {Presidente}
\committeestring(r,1,m,en) := {Arguente}
\committeestring(r,1,f,en) := {Arguente}
\committeestring(a,1,m,en) := {Orientador}
\committeestring(a,1,f,en) := {Orientadora}
\committeestring(ca,1,m,en):= {Co-orientador}
\committeestring(ca,1,f,en):= {Co-orientadora}
\committeestring(m,1,m,en) := {Vogal}
\committeestring(m,1,f,en) := {Vogal}
\committeestring(m,2,m,en) := {Vogais}
\committeestring(m,2,f,en) := {Vogais}

% Original English options (commented out):
% \committeestring(c,1,m,en) := {Chair}
% \committeestring(c,1,f,en) := {Chair}
% \committeestring(r,1,m,en) := {Examiner}
% \committeestring(r,1,f,en) := {Examiner}
% \committeestring(a,1,m,en) := {Supervisor}
% \committeestring(a,1,f,en) := {Supervisor}
% \committeestring(ca,1,m,en):= {Co-supervisor}
% \committeestring(ca,1,f,en):= {Co-supervisor}
% \committeestring(m,1,m,en) := {Member}
% \committeestring(m,1,f,en) := {Member}
% \committeestring(m,2,m,en) := {Members}
% \committeestring(m,2,f,en) := {Members}


% -----------------------------------------------------------------
% 4. COVER LAYOUT (PAGES 1 AND 2)
% -----------------------------------------------------------------

% Definition of text column widths (Author on left, Title on right)
\newcommand{\@leftcol}{0.37\linewidth}
\newcommand{\@rightcol}{0.55\linewidth}

% Load necessary fonts (Helvetica/Arial)
\AtEndPreamble{%
  \LoadHelveticaLikeFont%
}

% Apply sans-serif font (sffamily) before printing the covers
\NTAddToHook{cover/1-1/text/pre}{%
  \sffamily%
}
\NTAddToHook{cover/2-1/text/pre}{%
  \sffamily%
}

% --- LOGO ---
% Page 1: Prints the school logo
\ntaddtocover[vspace=0cm]{1-1}{%
  \includegraphics[height=4.6cm]{\expanded{\theschool(logo)}}%
}
% Page 2: Prints an invisible box (\rule) with the SAME height.
% This ensures the text below starts at the exact same vertical position
% on both pages, without the image on the second one.
\ntaddtocover[vspace=0cm]{2-1}{%
  \rule{0cm}{4.6cm}%
}

% --- AUTHOR AND TITLE (Appears on both covers) ---
\ntaddtocover[halign=l, vspace=5cm]{1-1,2-1}{%
  % Left Column: Author Name
  \begin{minipage}[t]{\@leftcol}%
    % Size 16pt, leading 18pt, right aligned
    \fontsize{16}{18}\selectfont\raggedleft%
    % \protect is needed before \MakeUppercase to avoid errors if line breaks exist
    \protect\MakeUppercase{\thedocauthor(name)}%
  \end{minipage}%
  \hfill%
  % Right Column: Thesis Title
  \begin{minipage}[t]{\@rightcol}%
    % Size 16pt, leading 18pt, left aligned, Bold
    \fontsize{16}{18}\selectfont\raggedright%
    \textbf{\protect\MakeUppercase{\thedoctitle(\@LANG@COVER,main,cover)}}%
  \end{minipage}%
}

% --- PHOTOGRAPH (Page 1 Only) ---
\ntaddtocover[halign=l, vspace=1]{1-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    \includegraphics[height=5.3cm]{\thefrontpageimage()}%
  \end{minipage}%
}

% --- PHOTOGRAPH SPACER (Page 2 Only) ---
% Invisible box to keep the Second Cover layout aligned with the First Cover.
\ntaddtocover[halign=l, vspace=1]{2-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    \rule{0cm}{5.3cm}% Height equal to the photograph
  \end{minipage}%
}

% --- PRESENTATION TEXT / DEGREE (Page 1 Only) ---
% Uses the \dissertationstring defined above
\ntaddtocover[halign=l, vspace=1]{1-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    % Size 12pt, leading 14pt
    \fontsize{12}{14}\selectfont\raggedright%
    \thepresentationtext%
  \end{minipage}%
}

% --- SUPERVISORS (Page 1 Only) ---
% Bottom block of the cover with the supervisor's name
\ntaddtocover[vspace=1]{1-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    % Label style (ORIENTADOR): Bold, Size 12pt
    \adviserstringfont(a):={\bfseries\fontsize{12}{14}\selectfont}%
    \adviserstringfont(c):={\bfseries\fontsize{12}{14}\selectfont}%
    % Name style: Size 12pt
    \fontsize{12}{14}\selectfont%
    \ntprintpersons{1}{2}{adviser}{a,c}%
  \end{minipage}%
}

% --- JURY (Page 2 Only - Front Page) ---
% Block replacing supervisors on the second page
\ntaddtocover[vspace=1]{2-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    % Title "JÚRI": Bold
    \committeetitlestringfont():={\bfseries}%
    % Labels "Presidente", "Vogal": Normal font (\upshape)
    \committeestringfont():={\upshape}% 
    % Text size: 11pt, leading 13pt
    \fontsize{11}{13}\selectfont%
    % Prints the full jury list
    \ntprintpersons{1}{2}{committee}{\thecommitteeorder()}%
  \end{minipage}%
}

% --- DATE (Appears on both covers) ---
\ntaddtocover[vspace=2]{1-1,2-1}{%
  \hfill%
  \begin{minipage}[t]{\@rightcol}%
    % Size 10pt, leading 12pt
    \fontsize{10}{12}\selectfont%
    \thentdocdate(submission,monthname) de \thentdocdate(submission,year)%
  \end{minipage}%
}